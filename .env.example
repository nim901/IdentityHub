APP_BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# 32 random bytes, base64; keep stable and secret, never use a shared example
ENCRYPTION_KEY=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/api/jira/callback
# Non-default authorization bases are not supported by the app in this phase.
ATLASSIAN_AUTH_BROWSER_BASE=https://auth.atlassian.com
ATLASSIAN_AUTH_BASE=https://auth.atlassian.com
ATLASSIAN_API_BASE=https://api.atlassian.com
# Optional preferred issue type; otherwise a supported Task is preferred.
JIRA_DEFAULT_ISSUE_TYPE=
DIGEST_USER_EMAIL=
DIGEST_PROJECT_KEY=
# OpenAI summary preview: configure a model and API key in the environment.
AI_MODEL=
AI_API_KEY=
